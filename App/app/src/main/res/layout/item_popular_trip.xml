<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="273dp"
    android:layout_height="80dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_popular_trip_card"
    android:orientation="horizontal"
    android:padding="10dp">

    <View
        android:id="@+id/viewThumbnail"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_trip_thumbnail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="11dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDeparture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="TP.HCM" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="4dp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="@string/departure" />

            <TextView
                android:id="@+id/tvDestination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Vũng Tàu" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvOriginalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/price_original"
            android:textSize="12sp"
            android:textStyle="normal"
            tools:text="180.000 VND" />

        <TextView
            android:id="@+id/tvCurrentPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/price_current"
            android:textSize="14sp"
            tools:text="150.000 VND" />

    </LinearLayout>

</LinearLayout>
